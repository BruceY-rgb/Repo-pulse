{
  "name": "@repo-pulse/electron",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently -k -n API,WEB,ELECTRON -c green,cyan,magenta \"cross-env FRONTEND_URL=http://127.0.0.1:5173 pnpm --filter @repo-pulse/api dev\" \"pnpm --filter @repo-pulse/web exec vite --host 127.0.0.1\" \"wait-on tcp:3001 tcp:5173 && pnpm --filter @repo-pulse/shared build && pnpm build:main && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "install:electron": "install-electron --no",
    "build": "pnpm --filter @repo-pulse/shared build && pnpm run build:main && cross-env VITE_DESKTOP=true pnpm --filter @repo-pulse/web build",
    "build:main": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "fetch:cloudflared": "node scripts/fetch-cloudflared.mjs",
    "package": "pnpm run fetch:cloudflared && pnpm run build && electron-builder",
    "start": "electron ."
  },
  "build": {
    "appId": "com.repopulse.desktop",
    "productName": "Repo Pulse",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web/dist"
      },
      {
        "from": "resources/bin",
        "to": "bin"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Development"
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.129",
    "@repo-pulse/shared": "workspace:*",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "typescript": "~5.9.3",
    "wait-on": "^9.0.10"
  }
}
